{
  "name": "voxal-mcp",
  "version": "1.0.0",
  "description": "Voxal is an MCP (Model Context Protocol) server that enables your AI models to autonomously place phone calls using Twilio Media Streams and the Gemini Multimodal Live API.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "voxal": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsc --watch & node --env-file=.env --watch dist/index.js"
  },
  "dependencies": {
    "@google/genai": "latest",
    "@modelcontextprotocol/sdk": "^1.5.0",
    "@ngrok/ngrok": "^1.7.0",
    "@types/express-ws": "^3.0.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-ws": "^5.0.2",
    "twilio": "^5.0.0",
    "wavefile": "^11.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.5"
  }
}