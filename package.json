{
  "name": "voxal-mcp",
  "version": "1.0.0",
  "description": "Voxal is an MCP (Model Context Protocol) server that enables your AI models to autonomously place phone calls using Twilio Media Streams and the Gemini Multimodal Live API.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "voxal": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc-watch -b tsconfig.json --onSuccess \"node dist/index.js\""
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@google/genai": "^2.3.0",
    "@modelcontextprotocol/express": "^2.0.0-alpha.2",
    "@modelcontextprotocol/node": "^2.0.0-alpha.2",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "@ngrok/ngrok": "^1.7.0",
    "@types/express-ws": "^3.0.6",
    "@types/yargs": "^17.0.35",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-ws": "^5.0.2",
    "twilio": "^5.0.0",
    "wavefile": "^11.0.0",
    "ws": "^8.16.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.4.5"
  }
}